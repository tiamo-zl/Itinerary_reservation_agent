# 运行环境：local / test / staging / prod
ENVIRONMENT=local

# PostgreSQL（compose 暴露 55432，避开 Langfuse 的 5432）
DATABASE_URL=postgresql://itinerary:itinerary_dev@127.0.0.1:55432/itinerary
TEST_DATABASE_URL=postgresql://itinerary:itinerary_dev@127.0.0.1:55432/itinerary_test

# Redis（compose 暴露 56379，避开 Langfuse 的 6379）
REDIS_URL=redis://127.0.0.1:56379/0

# 鉴权：mock 仅允许 local/test；staging/prod 必须 jwt 或 oidc
AUTH_MODE=mock

# 聊天模型（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_LIGHT=deepseek-chat
MODEL_STANDARD=deepseek-chat
MODEL_REASONING=deepseek-reasoner
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# 备用模型（OpenAI 兼容）；FALLBACK_API_KEY 为空时复用 DASHSCOPE_API_KEY
MODEL_FALLBACK_ENABLED=true
FALLBACK_PROVIDER_NAME=dashscope
FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FALLBACK_API_KEY=
FALLBACK_MODEL_LIGHT=qwen-plus
FALLBACK_MODEL_STANDARD=qwen-plus
FALLBACK_MODEL_REASONING=qwen-plus
LLM_CACHE_TTL_SECONDS=86400
MODEL_PRICING_FILE=config/pricing.yaml

# Embedding（阿里云百炼 OpenAI 兼容）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024

# 本地 Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
POLICY_VERSION=2026.1

# scripted：离线脚本模型；live：真实模型
MODEL_MODE=scripted
# mock：模拟外部系统；real：真实适配器（当前未实现）
ADAPTER_MODE=mock

# 模拟审批：默认手动，审批页需要能看到待办
MOCK_APPROVAL_AUTO_APPROVE=false
MOCK_APPROVAL_DELAY_SECONDS=5
