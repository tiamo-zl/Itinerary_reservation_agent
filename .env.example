# 运行环境：local / test / staging / prod
ENVIRONMENT=local

# PostgreSQL（compose 暴露 55432，避开 Langfuse 的 5432）
DATABASE_URL=postgresql://itinerary:itinerary_dev@127.0.0.1:55432/itinerary
TEST_DATABASE_URL=postgresql://itinerary:itinerary_dev@127.0.0.1:55432/itinerary_test

# Redis（compose 暴露 56379，避开 Langfuse 的 6379）
REDIS_URL=redis://127.0.0.1:56379/0

# 鉴权：mock 仅允许 local/test；staging/prod 必须 jwt 或 oidc
AUTH_MODE=mock
JWT_SECRET=
JWT_ISSUER=itinerary-agent-local
JWT_AUDIENCE=itinerary-agent
OIDC_ISSUER=
OIDC_AUDIENCE=itinerary-agent
OIDC_JWKS_URL=

# 聊天模型（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_LIGHT=deepseek-chat
MODEL_STANDARD=deepseek-chat
MODEL_REASONING=deepseek-reasoner
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# 备用模型（OpenAI 兼容）；FALLBACK_API_KEY 为空时复用 DASHSCOPE_API_KEY
MODEL_FALLBACK_ENABLED=true
FALLBACK_PROVIDER_NAME=dashscope
FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FALLBACK_API_KEY=
FALLBACK_MODEL_LIGHT=qwen-plus
FALLBACK_MODEL_STANDARD=qwen-plus
FALLBACK_MODEL_REASONING=qwen-plus
LLM_CACHE_BACKEND=auto
LLM_CACHE_TTL_SECONDS=86400
MODEL_PRICING_FILE=config/pricing.yaml
# Prompt 版本（v1/v2；v2 目前用于 understand）
PROMPT_VERSION=v1
# 每任务 token/成本预算；0 表示不限制
TASK_TOKEN_BUDGET=0
TASK_COST_BUDGET_USD=0
# 主备模型共享熔断（Redis 跨进程）
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_TRIAL_SECONDS=5

# 接口限流（每分钟固定窗口）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_APPROVAL_PER_MINUTE=60
RATE_LIMIT_FEEDBACK_PER_MINUTE=20

# HTTP 边界：生产环境不允许通配符；列表使用 JSON 数组
CORS_ORIGINS=["http://127.0.0.1:5211","http://localhost:5211","http://127.0.0.1:8080","http://localhost:8080","http://127.0.0.1:8081","http://localhost:8081"]
TRUSTED_HOSTS=["*"]
SSE_PING_SECONDS=15
CHAT_TURN_TIMEOUT_SECONDS=300

# 保留清理：只清理 span 投影、过期缓存、已结束 outbox 和过期幂等键
RETENTION_ENABLED=true
RETENTION_INTERVAL_SECONDS=3600
TRACE_RETENTION_DAYS=7
OUTBOX_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7

# 可观测：OTel 默认关闭，离线启动不依赖 Collector
OTEL_ENABLED=false
OTEL_SERVICE_NAME=itinerary-agent
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLING_RATIO=1.0
LOG_LEVEL=INFO

# Langfuse OTLP 基础认证：base64(public_key:secret_key)
LANGFUSE_AUTH=

# Embedding（阿里云百炼 OpenAI 兼容）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024

# 本地 Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
POLICY_VERSION=2026.1

# scripted：离线脚本模型；live：真实模型
MODEL_MODE=scripted
# mock：进程内 mock；http：独立 mock 依赖服务；real：真实适配器（预留）
ADAPTER_MODE=mock
# ADAPTER_MODE=http 时生效
MOCK_DEPS_URL=http://127.0.0.1:9003
UPSTREAM_TIMEOUT_SECONDS=5
UPSTREAM_MAX_RETRIES=2

# 模拟审批：默认手动，审批页需要能看到待办
MOCK_APPROVAL_AUTO_APPROVE=false
MOCK_APPROVAL_DELAY_SECONDS=5
